# ============================================================================
# Sample values for generic artifacts module
# ============================================================================
# This file provides example values for artifacts repository and generic artifacts.
# - Required: `artifacts_repository_compartment_id`, `artifacts_repository_display_name`, 
#   `generic_artifact_content_map` with artifact_path and version entries.
# - Optional values are shown commented out; uncomment and customize as needed.

# ============================================================================
# Artifacts Repository Settings
# ============================================================================
artifacts_repository_compartment_id = "<compartment-ocid>"
artifacts_repository_display_name   = "example-artifacts-repo"

# Optional repository settings
# artifacts_repository_description     = "Repository for application artifacts"
# artifacts_repository_is_immutable    = false
# artifacts_repository_repository_type = "GENERIC"

# Repository tags
artifacts_repository_defined_tags = {}
artifacts_repository_freeform_tags = {
  "Environment" = "dev"
  "ManagedBy"   = "Terraform"
}

# ============================================================================
# Generic Artifact Content Map
# ============================================================================
# Map-based configuration for managing multiple artifact entries.
# Key: artifact identifier (e.g., "app-jar", "config-file")
# Each entry contains: path, version, optional source/content, and tags

