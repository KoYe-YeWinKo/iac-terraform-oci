# ============================================================================
# Sample vault_secret_map auto.tfvars
# ============================================================================
# This file provides examples for the `vault_secret_map` module input.
# - Provide one or more secrets as map entries keyed by an arbitrary name.
# - Required fields: `vault_secret_compartment_id`, `vault_secret_secret_name`.
# - Optional fields are set to defaults; uncomment and modify as needed.
# - Groups below describe related configuration options.

# ---------------------------------------------------------------------------
# Active example: simple secret with explicit content
# ---------------------------------------------------------------------------
vault_secret_map = {
  my_dba_password = {
    # Core secret identity and location
    vault_secret_compartment_id = "<compartment-ocid>"
    vault_secret_key_id         = "<key-ocid>"
    vault_secret_vault_id       = "<vault-ocid>"
    vault_secret_secret_name    = "my-dba-password"

    # Tagging
    vault_secret_defined_tags  = {}
    vault_secret_freeform_tags = {}

    # Description and metadata
    vault_secret_description            = ""
    vault_secret_metadata               = {}
    vault_secret_enable_auto_generation = false

    # Secret content configuration
    is_vault_secret_secret_content_defined = true
    vault_secret_secret_content_type       = "BASE64"
    vault_secret_secret_content            = "PHZhcj4mbHQ7YmFzZTY0X2VuY29kZWRfc2VjcmV0X2NvbnRlbnRzJmd0OzwvdmFyPg=="
    vault_secret_secret_content_name       = "test-secret-content"
    vault_secret_secret_content_stage      = "CURRENT"

    # Secret generation context (used for auto-generated secrets)
    is_vault_secret_secret_generation_context_defined = false
    vault_secret_secret_generation_context            = null
    vault_secret_secret_generation_type               = null
    vault_secret_secret_generation_passphrase_length  = null
    vault_secret_secret_generation_template           = null

    # Secret rules (expiry, retrieval blocking, etc.)
    is_vault_secret_secret_rules_defined                                    = false
    vault_secret_secret_rules_is_enforced_on_deleted_secret_versions        = null
    vault_secret_secret_rules_is_secret_content_retrieval_blocked_on_expiry = null
    vault_secret_secret_rules_rule_type                                     = null
    vault_secret_secret_rules_secret_version_expiry_interval                = null
    vault_secret_secret_rules_time_of_absolute_expiry                       = null

    # Replication configuration
    is_enable_vault_secret_replication_config                           = false
    vault_secret_replication_config_replication_targets_target_key_id   = null
    vault_secret_replication_config_replication_targets_region          = null
    vault_secret_replication_config_replication_targets_target_vault_id = null
    vault_secret_replication_config_is_write_forward_enabled            = null

    # Rotation configuration
    is_enable_vault_secret_rotation_config                                = false
    vault_secret_rotation_config_target_system_details_target_system_type = null
    vault_secret_rotation_config_target_system_details_adb_id             = null
    vault_secret_rotation_config_target_system_details_function_id        = null
    vault_secret_rotation_config_is_scheduled_rotation_enabled            = null
    vault_secret_rotation_config_rotation_interval                        = null
  },
  my_os_password = {
    # Core secret identity and location
    vault_secret_compartment_id = "<compartment-ocid>"
    vault_secret_key_id         = "<key-ocid>"
    vault_secret_vault_id       = "<vault-ocid>"
    vault_secret_secret_name    = "my-os-password"

    # Tagging
    vault_secret_defined_tags  = {}
    vault_secret_freeform_tags = {}

    # Description and metadata
    vault_secret_description            = ""
    vault_secret_metadata               = {}
    vault_secret_enable_auto_generation = false

    # Secret content configuration
    is_vault_secret_secret_content_defined = true
    vault_secret_secret_content_type       = "BASE64"
    vault_secret_secret_content            = "PHZhcj4mbHQ7YmFzZTY0X2VuY29kZWRfc2VjcmV0X2NvbnRlbnRzJmd0OzwvdmFyPg=="
    vault_secret_secret_content_name       = "test-secret-content"
    vault_secret_secret_content_stage      = "CURRENT"

    # Secret generation context (used for auto-generated secrets)
    is_vault_secret_secret_generation_context_defined = false
    vault_secret_secret_generation_context            = null
    vault_secret_secret_generation_type               = null
    vault_secret_secret_generation_passphrase_length  = null
    vault_secret_secret_generation_template           = null

    # Secret rules (expiry, retrieval blocking, etc.)
    is_vault_secret_secret_rules_defined                                    = false
    vault_secret_secret_rules_is_enforced_on_deleted_secret_versions        = null
    vault_secret_secret_rules_is_secret_content_retrieval_blocked_on_expiry = null
    vault_secret_secret_rules_rule_type                                     = null
    vault_secret_secret_rules_secret_version_expiry_interval                = null
    vault_secret_secret_rules_time_of_absolute_expiry                       = null

    # Replication configuration
    is_enable_vault_secret_replication_config                           = false
    vault_secret_replication_config_replication_targets_target_key_id   = null
    vault_secret_replication_config_replication_targets_region          = null
    vault_secret_replication_config_replication_targets_target_vault_id = null
    vault_secret_replication_config_is_write_forward_enabled            = null

    # Rotation configuration
    is_enable_vault_secret_rotation_config                                = false
    vault_secret_rotation_config_target_system_details_target_system_type = null
    vault_secret_rotation_config_target_system_details_adb_id             = null
    vault_secret_rotation_config_target_system_details_function_id        = null
    vault_secret_rotation_config_is_scheduled_rotation_enabled            = null
    vault_secret_rotation_config_rotation_interval                        = null
  }
}

