# ---------------------------------------------------------------------------
# Notes for reviewers
# - All fields must be provided in the map; use null for optional fields not in use
# - Do NOT use empty strings ("") for time/date fields—use null instead
# - is_vault_secret_secret_content_defined = true when providing explicit secret_content
# - is_vault_secret_secret_generation_context_defined = true when auto-generating secrets
# - is_vault_secret_secret_rules_defined = true when configuring expiry/retrieval rules
# - Secret content fields ignored when vault_secret_enable_auto_generation = true
# - Replication/rotation configs controlled by their respective is_enable_* flags
# ---------------------------------------------------------------------------


